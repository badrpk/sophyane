{
  "id": "email.imap",
  "title": "Gmail IMAP (read-only)",
  "match_resources": [
    "email",
    "e-mail",
    "inbox",
    "gmail",
    "mail"
  ],
  "ops": {
    "latest": {
      "match_hints": [
        "last email",
        "latest email",
        "last mail",
        "my last email",
        "what was my last email"
      ]
    },
    "search": {
      "match_hints": [
        "in my email",
        "in my mail",
        "from my inbox",
        "search email",
        "search my email",
        "find in email",
        "find in my email",
        "look in my email",
        "see in my email",
        "company in email",
        "what company",
        "which company"
      ]
    },
    "sent": {
      "match_hints": [
        "last outgoing email",
        "last sent email",
        "latest sent email",
        "last email i sent",
        "outgoing email",
        "sent mail",
        "my last sent",
        "latest outgoing email",
        "most recent email i sent"
      ]
    },
    "analyze": {
      "match_hints": [
        "analyze my email",
        "analyze my emails",
        "inspect my inbox",
        "search inbox and sent",
        "inbox and sent mail",
        "conversation thread",
        "reconstruct the thread",
        "emails containing attachments",
        "email attachments",
        "most frequently by email",
        "received count",
        "sent count",
        "classify my emails",
        "last 200 received emails",
        "invoice or payment",
        "invoices receipts",
        "payment confirmations",
        "api keys credentials",
        "authentication oauth",
        "access tokens",
        "unresolved email",
        "require action from me",
        "subsequently replied",
        "cannot find a later sent reply"
      ]
    }
  },
  "required_secrets": [
    "imap_user",
    "imap_app_password"
  ]
}
